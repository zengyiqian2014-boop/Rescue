;;; rescuemon.inf - install information for the RescueMon minifilter.
;;;
;;; NOTE: the Altitude below is a development placeholder in the Anti-Virus
;;; range (320000-329998). A released filter must request its own unique
;;; altitude from Microsoft (see driver/README.md).

[Version]
Signature   = "$Windows NT$"
Class       = "AntiVirus"
ClassGuid   = {b1d1a169-c54f-4379-81db-bee7d88d7454}
Provider    = %ManufacturerName%
DriverVer   =
CatalogFile = rescuemon.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir          = 12
MiniFilter.DriverFiles  = 12            ; %windir%\system32\drivers

[DefaultInstall.NTamd64]
OptionDesc  = %ServiceDesc%
CopyFiles   = MiniFilter.DriverFiles

[DefaultInstall.NTamd64.Services]
AddService  = %ServiceName%,,MiniFilter.Service

[DefaultUninstall.NTamd64]
DelFiles    = MiniFilter.DriverFiles

[DefaultUninstall.NTamd64.Services]
DelService  = %ServiceName%,0x200      ; SPSVCINST_STOPSERVICE

[MiniFilter.Service]
DisplayName    = %ServiceName%
Description    = %ServiceDesc%
ServiceBinary  = %12%\rescuemon.sys
Dependencies   = "FltMgr"
ServiceType    = 2                      ; SERVICE_FILE_SYSTEM_DRIVER
StartType      = 0                      ; SERVICE_BOOT_START (protect early)
ErrorControl   = 1
LoadOrderGroup = "FSFilter Anti-Virus"
AddReg         = MiniFilter.AddRegistry

[MiniFilter.AddRegistry]
HKR,"Instances","DefaultInstance",0x00000000,%DefaultInstance%
HKR,"Instances\"%Instance1.Name%,"Altitude",0x00000000,%Instance1.Altitude%
HKR,"Instances\"%Instance1.Name%,"Flags",0x00010001,%Instance1.Flags%

[MiniFilter.DriverFiles]
rescuemon.sys

[Strings]
ManufacturerName   = "Rescue (Open Source)"
ServiceName        = "RescueMon"
ServiceDesc        = "Rescue anti-ransomware minifilter"
DefaultInstance    = "RescueMon Instance"
Instance1.Name     = "RescueMon Instance"
Instance1.Altitude = "329100"          ; DEV placeholder - request a real one
Instance1.Flags    = 0x0               ; allow attach/detach
