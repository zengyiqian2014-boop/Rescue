#include <winver.h>

// UAC manifest (requireAdministrator).
1 24 "rescue.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Open Source"
      VALUE "FileDescription",  "Rescue - Lockdown Breaker (undo malware lockdowns)"
      VALUE "FileVersion",      "0.1.0.0"
      VALUE "InternalName",     "lockdown_breaker"
      VALUE "OriginalFilename", "lockdown_breaker.exe"
      VALUE "ProductName",      "Rescue"
      VALUE "ProductVersion",   "0.1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
